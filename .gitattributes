# Normalise text to LF in the repository and working tree (Jenkinsfile, Dockerfiles,
# shell scripts and Ansible YAML must be LF to run on Linux).
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.jar binary
*.zip binary
*.woff binary
*.woff2 binary
