# Copy to .env (git-ignored) and fill in locally. Never commit real values.
# Placeholders only — these are not working credentials.

# Database (Compose service "db"; host access is not published by default)
LASTMILE_DB_NAME=lastmile
LASTMILE_DB_USER=lastmile
LASTMILE_DB_PASSWORD=change-me-locally
LASTMILE_DB_URL=jdbc:postgresql://db:5432/lastmile

# Application
LASTMILE_SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Demo accounts are created only when the "demo" profile is active AND this is set.
# Use a long, locally generated value; never reuse it anywhere else.
LASTMILE_DEMO_PASSWORD=

# Deployment
LASTMILE_HTTP_PORT=8088
LASTMILE_IMAGE=localhost:5000/lastmile-delivery
LASTMILE_IMAGE_TAG=
